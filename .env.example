# social-hub 配置（全部有默认值，可不配置直接跑）
# 数据目录（DB/凭据/媒体/日志都在这）
SOCIAL_HUB_DATA_DIR=
# API Bearer Token（留空 = 仅允许 loopback 本机访问）
SOCIAL_HUB_API_TOKEN=
# 覆盖 DB 连接（默认 sqlite:///{data_dir}/social-hub.db）
SOCIAL_HUB_DB_URL=
# 队列租约秒数 / worker 数
SOCIAL_HUB_LEASE_SECONDS=120
SOCIAL_HUB_WORKERS=1
# 服务端口
SOCIAL_HUB_PORT=8767
